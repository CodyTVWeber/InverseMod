    "function analyzePrimes(limit) {\n",
    "  const primes = [];\n",
    "  const composites = [];\n",
    "  \n",
    "  for (let i = 2; i <= limit; i++) {\n",
    "    let isPrime = true;\n",
    "    for (let j = 2; j <= Math.sqrt(i); j++) {\n",
    "      if (i % j === 0) {\n",
    "        isPrime = false;\n",
    "        break;\n",
    "      }\n",
    "    }\n",
    "    if (isPrime) {\n",
    "      primes.push(i);\n",
    "    } else {\n",
    "      composites.push(i);\n",
    "    }\n",
    "  }\n",
    "  \n",
    "  return {\n",
    "    limit,\n",
    "    primeCount: primes.length,\n",
    "    compositeCount: composites.length,\n",
    "    primeRatio: primes.length / limit,\n",
    "    firstTenPrimes: primes.slice(0, 10),\n",
